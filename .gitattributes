# Keep repository text files portable across Windows and CI environments.
* text=auto eol=lf
*.cs text diff=csharp
*.shader text
*.compute text
*.asmdef text
*.asmref text
*.unity text
*.asset text
*.meta text
*.prefab text
*.mat text
*.controller text
*.anim text
*.json text
*.md text
*.yml text
*.yaml text

# Store large Unity art, audio, video, and plugin binaries through Git LFS.
*.psd filter=lfs diff=lfs merge=lfs -text
